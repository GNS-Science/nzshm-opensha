// Joint inversion tuned for rupture diversity.
//
// Identical to NZSHM_config-parallel-even-fit.jsonc except that every weight is 10x
// lower again (0.01 rather than 0.1). See that file for why each setting is what it is.
//
// The overall weight scale acts as an annealing temperature: scaling all weights by k
// scales every energy by k^2, and acceptance is exp(-dE/T). A lower scale searches
// hotter and finds more diverse solutions. It is also the only scale at which every
// constraint reaches even fit - at higher scales Puysegur pins itself to the
// reweighter's lower bound and ends up over-fitted relative to everything else.
//
// Measured against the old config, both run for 20 minutes on the run_4 rupture set:
//    crustal slip   0.777 -> 0.674 sigma     Hikurangi MFD  35.6% -> 6.7%
//    crustal MFD    11.6% -> 6.7%            Puysegur MFD   28.0% -> 6.7%
//    paleo          0.777 -> 0.674 sigma     Hikurangi slip 24.5% -> 33.5%
//                                            Puysegur slip   0.3% -> 32.8%
//    ruptures above 1e-7/yr   4,587 -> 27,096
//    effective rupture count    788 -> 3,781
//
// Puysegur slip at 32.8% is the even-fit answer given its sigma of 0.5 * rate: it sits
// at 0.65 sigma like every other constraint. Use this config only if subduction slip
// really is believed to +/-50%. If it is not, prefer the 0.1 scale config, or give the
// subduction deformation models real slip rate standard deviations.

{
  "ruptureSetPath": "C:\\runs\\run_4\\mergedRupset_15km_cffPatch2km_cff0SelfStiffness.zip",
  "annealing": {
    "inversionSecs": 240,
    "selectionInterval": 10,
    // Keep averaging on and at the selection interval. Averaging roughly doubles the
    // number of meaningful non-zero rates. Raising this interval also starves the
    // reweighter, which runs once per averaging round.
    "inversionAveragingIntervalSecs": 10,
    "inversionNumSolutionAverages": 4,
    "inversionThreadsPerSelector": 0,
    "inversionAveragingEnabled": true,
    "perturbationFunction": "VARIABLE_EXPONENTIAL_SCALE",
    // LIMIT_ZERO_RATES leaves a large tail of near-zero rates. Threshold them after the
    // run instead: discarding everything below 1e-9 removes ~90% of the non-zero
    // ruptures and 0.007% of the total rate. TRY_ZERO_RATES_OFTEN does the cleanup
    // during annealing but destroys a quarter of the genuine ruptures doing it.
    "nonNegAlgorithm": "LIMIT_ZERO_RATES",
    "excludeRupturesBelowMinMag": false,
    "reweightTargetQuantity": "MAD",
    "coolingSchedule": "FAST_SA"
  },
  "partitions": [
    {
      "partition": "CRUSTAL",

      "slipRateWeightingType": "NORMALIZED_BY_UNCERTAINTY",
      "slipRateUncertaintyConstraintWt": 0.01,
      "slipRateUncertaintyConstraintScalingFactor": 0.0,
      "unmodifiedSlipRateStdvs": true,

      "deformationModel": "FAULT_MODEL",
      "totalRateM5": 3.4,
      "bValue": 0.959,
      "minMag": 6.799,
      "maxMag": 10.0,
      "maxMagType": "MANIPULATE_MFD",
      "mfdTransitionMag": 7.85,
      "mfdUncertaintyWeight": 0.01,
      "mfdUncertaintyPower": 0.25,
      "mfdUncertaintyScalar": 0.1,
      "spatialSeisPDF": "FLOOR_ADDOPTIEEPASCOMB_CRU",
      "polygonBufferSize": 12,
      "polygonMinBufferSize": 0
    },
    {
      "partition": "HIKURANGI",
      "slipRateWeightingType": "NORMALIZED_BY_UNCERTAINTY",
      "slipRateUncertaintyConstraintWt": 0.01,
      "slipRateUncertaintyConstraintScalingFactor": 0.0,
      // true so the real sigmas are used where they exist; subduction sections have
      // none, so SlipRateInversionConstraint substitutes 0.5 * rate.
      "unmodifiedSlipRateStdvs": true,
      "deformationModel": "SBD_0_2A_HKR_MMIN7PT5_EXP_LTP1A",
      "totalRateM5": 21.5,
      "bValue": 1.097,
      "minMag": 7.5,
      "mfdTransitionMag": 9.15,
      "mfdEqualityConstraintWt": 0.0,
      "mfdInequalityConstraintWt": 0,
      // power ~0 makes sigma = scalar * rate, so within the target magnitude range this
      // is the same constraint the equality weight expressed, only visible to the
      // reweighter. Below minMag it is 10x weaker, which still pins those bins hard.
      "mfdUncertaintyWeight": 0.01,
      "mfdUncertaintyPower": 0.001,
      "mfdUncertaintyScalar": 0.1
    },
    {
      "partition": "PUYSEGUR",
      "slipRateWeightingType": "NORMALIZED_BY_UNCERTAINTY",
      "slipRateUncertaintyConstraintWt": 0.01,
      "slipRateUncertaintyConstraintScalingFactor": 0.0,
      "unmodifiedSlipRateStdvs": true,
      "deformationModel": "SBD_0_1_PUY_30_0PT7",
      "totalRateM5": 4.6,
      "bValue": 0.902,
      "minMag": 7.0,
      "mfdTransitionMag": 9.15,
      "mfdEqualityConstraintWt": 0.0,
      "mfdInequalityConstraintWt": 0,
      "mfdUncertaintyWeight": 0.01,
      "mfdUncertaintyPower": 0.001,
      "mfdUncertaintyScalar": 0.1
    }
  ],
  "scalingRelationshipName": "JOIN_ESTIMATE",
  "recalcMags": true,

  "sansSlipRateFactor": 0.9,
  "tvzSlipRateFactor": 0.7,

  // Scaled with everything else so the relative balance is unchanged. The Laplacian is
  // not uncertainty-weighted, so it is the one constraint the reweighter cannot adjust.
  "paleoRateConstraintWt": 0.01,
  "paleoParentRateSmoothnessConstraintWeight": 1000000.0,
  "paleoRates": "PALEO_RI_GEOLOGIC_MAY24",
  "paleoProbabilityModel": "NZSHM22_C_42",
  "extraPaleoRatesFile": null
}
